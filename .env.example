# Secrets and per-machine URLs only. Every tunable lives in zipy.toml.
# Any ZIPY_<TABLE>__<KEY> works; plugin secrets are ZIPY_<KIND>__<NAME>__<KEY>.

# Point at a config outside the repo.
#ZIPY_CONFIG_FILE=

# ---- platforms: one block per [platforms.*] table that is enabled
ZIPY_PLATFORMS__DISCORD__TOKEN=
#ZIPY_PLATFORMS__SLACK__CLIENT_ID=
#ZIPY_PLATFORMS__SLACK__CLIENT_SECRET=
#ZIPY_PLATFORMS__SLACK__SIGNING_SECRET=

# ---- models: a key per [models.*] role whose provider needs one
ZIPY_MODELS__CHAT__API_KEY=
ZIPY_MODELS__SUMMARY__API_KEY=
ZIPY_MODELS__EMBEDDING__API_KEY=

# ---- data: compose (just up) serves both on loopback
ZIPY_DATA__DATABASE_URL=postgresql+asyncpg://zipy:zipy@127.0.0.1:5432/zipy
ZIPY_DATA__REDIS_URL=redis://127.0.0.1:6379/0
# Fernet key for credentials and bot tokens at rest: just fernet-key prints one. Losing it loses them.
ZIPY_DATA__FERNET_KEY=

# ---- api: the public base URL OAuth providers and platforms call back to
ZIPY_API__PUBLIC_URL=http://127.0.0.1:8080

# ---- providers: one OAuth app per [providers.*] table
ZIPY_PROVIDERS__GOOGLE__CLIENT_ID=
ZIPY_PROVIDERS__GOOGLE__CLIENT_SECRET=
ZIPY_PROVIDERS__NOTION__CLIENT_ID=
ZIPY_PROVIDERS__NOTION__CLIENT_SECRET=
ZIPY_PROVIDERS__ZOOM__CLIENT_ID=
ZIPY_PROVIDERS__ZOOM__CLIENT_SECRET=
ZIPY_PROVIDERS__ZOOM__WEBHOOK_SECRET=

# ---- telemetry: empty sends nothing
ZIPY_TELEMETRY__SENTRY_DSN=
ZIPY_TELEMETRY__LANGFUSE_HOST=http://127.0.0.1:3000
ZIPY_TELEMETRY__LANGFUSE_PUBLIC_KEY=
ZIPY_TELEMETRY__LANGFUSE_SECRET_KEY=

# ---- compose only
ZIPY_POSTGRES_PASSWORD=zipy
ZIPY_LANGFUSE_NEXTAUTH_SECRET=
ZIPY_LANGFUSE_SALT=
ZIPY_GRAFANA_PASSWORD=
