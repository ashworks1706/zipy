    {
      "id": 5,
      "type": "stat",
      "title": "p95 reply time",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 18,
